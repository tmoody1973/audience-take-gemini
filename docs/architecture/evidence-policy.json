    },
    {
      "label": "Decide"
    },
    {
      "label": "Publish"
    }
  ],
  "nodes": [
    {
      "id": "lead",
      "type": "external",
      "label": "Public source",
      "sublabel": "Parallel discovery",
      "stage": 0,
      "row": 1
    },
    {
      "id": "passage",
      "type": "database",
      "label": "Passage record",
      "sublabel": "URL + time + content",
      "stage": 1,
      "row": 1
    },
    {
      "id": "support",
      "type": "security",
      "label": "Support check",
      "sublabel": "Identity + exact claim",
      "stage": 2,
      "row": 1
    },
    {
      "id": "accepted",
      "type": "database",
      "label": "Supported claim",
      "sublabel": "Versioned evidence",
      "stage": 3,
      "row": 1
    },
    {
      "id": "unknown",
      "type": "backend",
      "label": "Unresolved",
      "sublabel": "Retain the question",
      "stage": 2,
      "row": 3
    },
    {
      "id": "card",
      "type": "frontend",
      "label": "Scout Card",
      "sublabel": "Fan + Pro brief",
      "stage": 4,
      "row": 1
    },
    {
      "id": "brief",
      "type": "backend",
      "label": "Audio briefing",
      "sublabel": "Same claim version",
      "stage": 4,
      "row": 3
    }
  ],
  "flows": [
    {
      "id": "capture",
      "from": "lead",
      "to": "passage",
      "label": "retrieve"
    },
    {
      "id": "assess",
      "from": "passage",
      "to": "support",
      "label": "inspect"
    },
    {
      "id": "approve",
      "from": "support",
      "to": "accepted",
      "label": "supported",
      "variant": "emphasis"
    },
    {
      "id": "withhold",
      "from": "support",
      "to": "unknown",
      "label": "insufficient",
      "variant": "security"
    },
    {
      "id": "publish",
      "from": "accepted",
      "to": "card",
      "label": "publish"
    },
    {
      "id": "narrate",
      "from": "card",
      "to": "brief",
      "label": "derive",
      "variant": "dashed"
    }
  ],
  "cards": [
